SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SURVEY_IP_HASH_PEPPER=
TRUST_PROXY=

# Area /kelola: layanan SSO pusat (sama dengan VITE_USERS_URL di matarammedika-admin). Bila kosong, /kelola tidak dapat dipakai tetapi situs publik tetap normal.
# Redirect https://<domain>/kelola/callback harus didaftarkan di layanan SSO.
SSO_USERS_URL=http://localhost:3200
# Origin publik situs (mis. https://matarammedika.id) untuk alamat callback SSO. Wajib di produksi bila kontainer berada di belakang proxy TLS.
SITE_ORIGIN=http://dev-sso.matarammedika

# Opsional: posting promo ke Instagram. Bila IG_USER_ID atau IG_ACCESS_TOKEN kosong, opsi Instagram disembunyikan.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=
IG_GRAPH_HOST=
