---
import { Menu, X } from "lucide-react";
import { navKlinik, type NavKlinikLabel } from "@/data/nav";
import { navLinkClass, navLinkMobileClass } from "./navClass";
import { gradientBg } from "@/components/shared/ui/gradient";
import Logo from "@/components/shared/ui/Logo";

interface Props {
  activeLabel: NavKlinikLabel;
  headerTone?: "tint" | "surface";
}

const { activeLabel, headerTone = "surface" } = Astro.props;
const headerBg = headerTone === "tint" ? "bg-surface-tint" : "bg-surface";
const ctaClass = `${gradientBg} min-h-11 items-center justify-center rounded-full px-7 py-3.5 font-body text-base font-semibold text-white shadow-cta transition-transform duration-200 ease-out active:scale-[0.96] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue motion-reduce:active:scale-100 lg:text-lg`;
---

<header class={`sticky top-0 z-50 ${headerBg}`}>
  <div class="page-container relative flex items-center justify-between gap-4 py-4">
    <a
      href="/"
      aria-label="Beranda"
      class="relative z-10 rounded-md shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
    >
      <Logo />
    </a>

    <nav
      class="hidden flex-1 gap-5 justify-center items-center min-w-0 text-sm lg:flex xl:gap-8 xl:text-base"
      aria-label="Navigasi utama"
    >
      {
        navKlinik.map((item) => (
          <a
            href={item.href}
            aria-current={item.label === activeLabel ? "page" : undefined}
            class={`whitespace-nowrap py-2 ${navLinkClass(item.label, activeLabel)}`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/#kontak" class={`hidden relative z-10 shrink-0 lg:inline-flex ${ctaClass}`}>
      Informasi
    </a>

    <details class="relative z-10 klinik-nav-menu lg:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-heading transition-colors duration-200 ease-out hover:bg-white/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue [&::-webkit-details-marker]:hidden"
        aria-label="Buka menu"
      >
        <Menu size={22} strokeWidth={1.75} className="klinik-nav-menu-icon-open" aria-hidden="true" />
        <X
          size={22}
          strokeWidth={1.75}
          className="hidden klinik-nav-menu-icon-close"
          aria-hidden="true"
        />
      </summary>

      <div class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(calc(100vw-2rem),20rem)] origin-top-right rounded-3xl bg-white p-3 shadow-nav">
        <nav class="flex flex-col gap-1" aria-label="Navigasi mobile">
          {
            navKlinik.map((item) => (
              <a
                href={item.href}
                aria-current={item.label === activeLabel ? "page" : undefined}
                class={navLinkMobileClass(item.label, activeLabel)}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a href="/#kontak" class={`inline-flex mt-3 w-full ${ctaClass}`}>Informasi</a>
      </div>
    </details>
  </div>
</header>
