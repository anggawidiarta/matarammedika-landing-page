---
import { buttonClass } from "@/components/kelola/ui/Button";
---

<div role="alert" class="shadow-card flex max-w-xl flex-col items-start gap-4 rounded-2xl bg-white px-6 py-8 sm:px-8">
  <h1 class="text-2xl leading-snug font-semibold text-balance">Daftar belum bisa dimuat</h1>
  <p class="text-heading/80 text-base leading-relaxed text-pretty">
    Terjadi gangguan saat mengambil data. Konten di situs publik tidak terpengaruh. Coba muat ulang halaman ini.
  </p>
  <a href={Astro.url.pathname} class={buttonClass("primary")}>Muat ulang</a>
</div>
