---
export const prerender = false;
import FeatureManager from "@/components/kelola/FeatureManager";
import LoadError from "@/components/kelola/LoadError.astro";
import KelolaLayout from "@/layouts/KelolaLayout.astro";
import { listItems } from "@/lib/kelola/items";
import type { KelolaItem } from "@/lib/kelola/types";

let items: KelolaItem[] = [];
let failed = false;
try {
  items = await listItems({ module: "fasilitas", source: "klinik" });
} catch (error) {
  console.error("[kelola] load fasilitas failed", error);
  failed = true;
}
---

<KelolaLayout title="Fasilitas" activeModule="fasilitas">
  {failed ? <LoadError /> : <FeatureManager client:load module="fasilitas" initialItems={items} />}
</KelolaLayout>
