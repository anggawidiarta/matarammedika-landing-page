---
export const prerender = false;
import LayananPage from "@/components/layanan/LayananPage";
import { layananSpecialists, layananUmumGigi } from "@/components/layanan/layananData";
import Layout from "@/layouts/Layout.astro";
import { PUBLIC_CACHE_CONTROL } from "@/lib/http";
import { itemsForSection } from "@/lib/cms/featureItems";
import { loadPublishedFeatures } from "@/lib/cms/loadPublishedFeatures";

const cmsItems = await loadPublishedFeatures("layanan");
const umumGigi = itemsForSection(cmsItems, "umum_gigi", [
  layananUmumGigi.umum,
  layananUmumGigi.gigi,
]);
const specialists = itemsForSection(cmsItems, "spesialis", layananSpecialists);
Astro.response.headers.set("Cache-Control", PUBLIC_CACHE_CONTROL);
---

<Layout activeLabel="Layanan">
  <LayananPage umumGigi={umumGigi} specialists={specialists} />
</Layout>
