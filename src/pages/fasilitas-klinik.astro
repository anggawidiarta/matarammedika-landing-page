---
export const prerender = false;
import FasilitasPage from "@/components/fasilitas/FasilitasPage";
import Layout from "@/layouts/Layout.astro";
import { PUBLIC_CACHE_CONTROL } from "@/lib/http";
import { itemsForSection } from "@/lib/cms/featureItems";
import { loadPublishedFeatures } from "@/lib/cms/loadPublishedFeatures";

const cmsItems = await loadPublishedFeatures("fasilitas");
const umum = itemsForSection(cmsItems, "umum");
const lainnya = itemsForSection(cmsItems, "lainnya");
Astro.response.headers.set("Cache-Control", PUBLIC_CACHE_CONTROL);
---

<Layout activeLabel="Fasilitas">
  <FasilitasPage umum={umum} lainnya={lainnya} />
</Layout>
