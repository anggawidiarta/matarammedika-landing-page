---
export const prerender = false;
import HomeBerandaHero from "@/components/home/HomeBerandaHero";
import HomeDoctorShowcase from "@/components/home/HomeDoctorShowcase";
import HomePage from "@/components/home/HomePage";
import Layout from "@/layouts/Layout.astro";
import { PUBLIC_CACHE_CONTROL } from "@/lib/http";
import { itemsForSection } from "@/lib/cms/featureItems";
import { loadPublishedFeatures } from "@/lib/cms/loadPublishedFeatures";
import { loadPublishedPromos } from "@/lib/cms/promo";
import { toPromoCards } from "@/lib/cms/promoDisplay";

const [layananCms, fasilitasCms, promoCms] = await Promise.all([
  loadPublishedFeatures("layanan"),
  loadPublishedFeatures("fasilitas"),
  loadPublishedPromos(),
]);

const layananPreview = itemsForSection(layananCms, "spesialis").slice(0, 6);
const fasilitasPreview = itemsForSection(fasilitasCms, "umum");
const promoPreview = toPromoCards(promoCms ?? [])
  .filter((promo) => promo.status !== "ended")
  .slice(0, 3);
Astro.response.headers.set("Cache-Control", PUBLIC_CACHE_CONTROL);
---

<Layout activeLabel="Beranda" headerTone="tint">
  <HomePage
    layananPreview={layananPreview}
    fasilitasPreview={fasilitasPreview}
    promoPreview={promoPreview}
  >
    <HomeBerandaHero client:load />
    <HomeDoctorShowcase client:visible />
  </HomePage>
</Layout>
