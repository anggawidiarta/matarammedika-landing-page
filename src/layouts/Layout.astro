---
import { ClientRouter } from "astro:transitions";
import KlinikHeader from "@/components/shared/layout/KlinikHeader";
import type { NavKlinikLabel } from "@/components/shared/data/navKlinik";
import "@/styles/global.css";

interface Props {
  title?: string;
  activeLabel?: NavKlinikLabel;
  headerTone?: "tint" | "surface";
}

const {
  title = "Apotek & Klinik Mataram Medika",
  activeLabel = "Beranda",
  headerTone = "surface",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" />
    <link rel="preload" href="/wordmark.svg" as="image" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Sora:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased bg-surface font-body text-heading">
    <KlinikHeader
      client:load
      transition:persist="klinik-header"
      activeLabel={activeLabel}
      headerTone={headerTone}
    />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
