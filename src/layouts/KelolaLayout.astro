---
import { Font } from "astro:assets";
import { ExternalLink, LogOut } from "lucide-react";
import { MODULE_ICONS } from "@/components/kelola/moduleIcons";
import { MODULE_LABELS, MODULES, type CmsModule } from "@/lib/kelola/constants";
import "@/styles/kelola.css";

interface Props {
  title: string;
  variant?: "gate" | "app";
  activeModule?: CmsModule;
}

const { title, variant = "app", activeModule } = Astro.props;
const user = Astro.locals.kelolaUser;
const userName = user?.displayName || user?.username;
const initials = (userName ?? "")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("");

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue";
const quietButton = `inline-flex min-h-11 items-center justify-center gap-2 rounded-lg text-sm font-medium max-sm:w-11 sm:px-3.5 text-heading/80 transition-colors duration-200 ease-out hover:bg-surface-tint hover:text-heading motion-reduce:transition-none ${focusRing}`;
---

<!doctype html>
<html lang="id" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Font cssVariable="--font-poppins" preload={[{ weight: 400, style: "normal" }, { weight: 600, style: "normal" }]} />
    <Font cssVariable="--font-sora" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Kelola Konten</title>
  </head>
  <body
    class={`min-h-screen font-body text-heading ${variant === "gate" ? "bg-surface-tint" : "bg-surface"}`}
  >
    {
      variant === "app" ? (
        <>
          <a
            href="#konten"
            class={`sr-only rounded-lg bg-white px-5 py-3 font-semibold text-blue shadow-cta focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] ${focusRing}`}
          >
            Lewati ke konten
          </a>
          <header class="sticky top-0 z-40 border-b border-heading/8 bg-white">
            <div class="page-container flex flex-wrap items-center justify-between gap-x-6">
              <a
                href="/kelola/layanan"
                class={`inline-flex min-h-14 items-center gap-3 rounded-lg ${focusRing}`}
              >
                <img src="/logo.svg" alt="" width="36" height="36" decoding="async" draggable="false" />
                <span class="flex flex-col leading-tight">
                  <span class="text-base font-semibold">Kelola Konten</span>
                  <span class="hidden text-xs text-heading/70 sm:block">Apotek &amp; Klinik Mataram Medika</span>
                </span>
              </a>

              <nav aria-label="Modul konten" class="order-last -mx-2 w-full md:order-none md:mx-0 md:mr-auto md:w-auto">
                <ul class="grid grid-cols-4 md:flex md:gap-1">
                  {MODULES.map((module) => {
                    const Icon = MODULE_ICONS[module];
                    const active = module === activeModule;
                    return (
                      <li>
                        <a
                          href={`/kelola/${module}`}
                          aria-current={active ? "page" : undefined}
                          class={`relative flex min-h-14 items-center justify-center gap-2 px-3 text-[13px] font-medium transition-colors duration-200 ease-out after:absolute after:inset-x-2 after:-bottom-px after:h-0.5 after:rounded-full after:transition-colors after:duration-200 motion-reduce:transition-none max-md:flex-col max-md:gap-0.5 max-md:px-1 md:min-h-16 md:text-sm ${focusRing} ${
                            active
                              ? "text-blue after:bg-blue"
                              : "text-heading/70 after:bg-transparent hover:text-heading hover:after:bg-heading/15"
                          }`}
                        >
                          <Icon size={18} strokeWidth={active ? 2 : 1.75} aria-hidden="true" />
                          {MODULE_LABELS[module]}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </nav>

              <div class="flex items-center gap-1">
                <a href="/" target="_blank" rel="noopener" class={quietButton}>
                  <ExternalLink size={18} aria-hidden="true" />
                  <span class="hidden sm:inline">Lihat situs</span>
                  <span class="sr-only sm:hidden">Lihat situs (tab baru)</span>
                </a>
                <form method="post" action="/kelola/keluar">
                  <button type="submit" class={`cursor-pointer ${quietButton}`}>
                    <LogOut size={18} aria-hidden="true" />
                    <span class="sr-only sm:not-sr-only">Keluar</span>
                  </button>
                </form>
                {userName && (
                  <span
                    title={userName}
                    class="ml-1 inline-flex size-9 shrink-0 select-none items-center justify-center rounded-full bg-surface-highlight font-accent text-sm font-semibold text-blue"
                  >
                    <span aria-hidden="true">{initials}</span>
                    <span class="sr-only">Masuk sebagai {userName}</span>
                  </span>
                )}
              </div>
            </div>
          </header>
          <main id="konten" tabindex="-1" class="page-container pt-8 pb-20 outline-none">
            <slot />
          </main>
        </>
      ) : (
        <main id="konten" class="grid min-h-screen place-items-center px-6 py-12">
          <slot />
        </main>
      )
    }
  </body>
</html>
